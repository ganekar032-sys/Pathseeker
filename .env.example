# Pathseeker serverless proxy — copy to .env.local for local development.
# (.env.local is gitignored; NEVER commit real keys.)
#
# On Vercel: Project → Settings → Environment Variables → add the same names.

# Required. Create a DEDICATED key for this app at https://openrouter.ai/keys
# with a $0 spend limit, and rotate any key that was ever bundled in source.
OPENROUTER_API_KEY=sk-or-v1-your-dedicated-key-here

# Optional throttling overrides (defaults shown).
RATE_LIMIT_IP_PER_HOUR=6
RATE_LIMIT_IP_PER_DAY=24
RATE_LIMIT_GLOBAL_PER_DAY=45
